{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Status",
  "type": "object",
  "required": [
    "status",
    "open_barrier_count",
    "barriers"
  ],
  "properties": {
    "status": {
      "enum": [
        "READY",
        "NOT READY"
      ]
    },
    "open_barrier_count": {
      "type": "integer",
      "minimum": 0
    },
    "barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "category",
          "description",
          "required_fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "$ref": "./release-evidence.schema.json"
    }
  }
}
