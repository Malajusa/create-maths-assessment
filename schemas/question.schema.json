{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment Question",
  "type": "object",
  "required": [
    "id",
    "marks",
    "target_level",
    "student_prompt",
    "expected_solution",
    "marking"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q[1-8]$"
    },
    "marks": {
      "type": "integer",
      "minimum": 1
    },
    "target_level": {
      "type": "string"
    },
    "curriculum_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_skill": {
      "type": "string"
    },
    "student_prompt": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "array"
    },
    "visual_spec": {
      "oneOf": [
        {"$ref": "./visual-spec.schema.json"},
        {"type": "null"}
      ]
    },
    "expected_solution": {
      "type": "object"
    },
    "alternative_valid_methods": {
      "type": "array"
    },
    "marking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["mark", "evidence", "evidence_band", "band_rationale", "why_not_lower_band"],
        "properties": {
          "mark": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "evidence_band": {"type": "string", "enum": ["D", "C", "B", "A"]},
          "band_rationale": {"type": "string", "minLength": 1},
          "why_not_lower_band": {"type": "string", "minLength": 1},
          "a_demand_feature": {
            "type": "string",
            "enum": ["inference", "adaptation", "interacting_constraints", "evaluation", "sustained_reasoning", "justification"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_band": {"const": "A"}}, "required": ["evidence_band"]},
            "then": {"required": ["a_demand_feature"]}
          }
        ]
      }
    },
    "misconceptions": {
      "type": "array"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q[1-8]$"
      },
      "uniqueItems": true
    }
  }
}
