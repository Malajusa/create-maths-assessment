{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment Brief",
  "type": "object",
  "required": ["year_levels", "topic", "jurisdiction", "outputs", "task_type", "user_overrides"],
  "properties": {
    "year_levels": {"type": "array", "minItems": 1, "items": {"type": ["integer", "string"]}},
    "topic": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "curriculum_targets": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"enum": ["student_test_pptx", "marking_key_pptx", "curriculum_rationale_pdf"]}},
    "task_type": {"enum": ["new", "revision", "alternate_version", "practice_version", "marking_key", "critical_review"]},
    "user_overrides": {"type": "array", "items": {"type": "string"}},
    "exemplar_profile": {"type": "object"},
    "visual_profile": {"$ref": "./visual-profile.schema.json"}
  },
  "additionalProperties": true
}
